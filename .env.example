# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real credentials.

# --- GitHub ---
# A personal access token (classic or fine-grained) with `repo` scope for the
# opensource-scout repository and read-only scope elsewhere. Never logged.
GITHUB_TOKEN=

# --- OpenAI ---
# Used for all programmatic LLM calls (classification, planning, patch help,
# PR drafting). Claude is used manually via `oss claude export/import` and is
# never called via an API key.
OPENAI_API_KEY=

# Logical model roles (see docs/architecture.md for how each is used).
# The same model name may be reused across roles.
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MODEL_CODING=gpt-4o

# --- Cost and token controls ---
DAILY_OPENAI_BUDGET_USD=5.0
MONTHLY_OPENAI_BUDGET_USD=50.0
MAX_LLM_CALLS_PER_WORKFLOW=40
MAX_INPUT_TOKENS_PER_CALL=12000
MAX_OUTPUT_TOKENS_PER_CALL=2000

# --- GitHub client behavior ---
GITHUB_CONCURRENCY=4

# --- Local storage ---
# Defaults to ~/.opensource-scout if unset.
OSS_DATA_DIR=
OSS_WORKSPACE_DIR=

# --- Logging ---
OSS_LOG_LEVEL=INFO
OSS_LOG_JSON=true
